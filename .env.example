# Public ingest key shipped in mobile apps. Used by POST /v1/events.
TELEMETRY_PUBLIC_API_KEY=dev-public-key

# Operator secret. Used by GET /v1/events and ops-only ingest.
# Must never be shipped in mobile builds.
TELEMETRY_ADMIN_API_KEY=dev-admin-key

# Postgres credentials used by the postgres service.
# DATABASE_URL is composed in compose.yaml from these values.
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_DB=telemetry

# CORS allowed origin for the telemetry API. In production prefer same origin.
ALLOWED_ORIGIN=*

# Set true to send Access-Control-Allow-Credentials. Browsers reject
# credentials=true combined with ALLOWED_ORIGIN=*, so leave this false unless
# you also pin a specific origin above.
ALLOW_CREDENTIALS=false

TELEMETRY_API_HOST_PORT=9999

API_PROXY_URL=http://telemetry-api:9999

# Prefix prepended to built service images. Leave empty to use locally
# untagged images (compose falls back to `build:`). Set to e.g.
# `ghcr.io/<owner>/<repo>/` to pull prebuilt images from GHCR.
IMAGE_PREFIX=

# versions of tools used in the Dockerfile
NODE_VERSION=
GO_VERSION=
PNPM_VERSION=
